<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SOLIDWORKS add-in. Builds on Windows with SOLIDWORKS installed.
    Override the API location if SOLIDWORKS is installed elsewhere:
      dotnet build -p:SolidWorksApiDir="D:\SOLIDWORKS\api\redist"
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GeoSimplifier.SolidWorks</RootNamespace>
    <AssemblyName>GeoSimplifier.SolidWorks</AssemblyName>
    <ComVisible>true</ComVisible>
    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The license public key (made once with tools\GeoSimplifier.LicenseTool "anahtar-olustur"); without it every license is refused. -->
  <ItemGroup Condition="Exists('Licensing\3DWrap-acik-anahtar.xml')">
    <EmbeddedResource Include="Licensing\3DWrap-acik-anahtar.xml" LogicalName="GeoSimplifier.SolidWorks.Licensing.3DWrap-acik-anahtar.xml" />
  </ItemGroup>

  <!-- The logo (Resources\Logo\*.svg is its source). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Logo\3dwrap_*.png" LogicalName="GeoSimplifier.SolidWorks.Logo.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoSimplifier.Core\GeoSimplifier.Core.csproj" />
  </ItemGroup>

</Project>
